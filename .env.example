# Copy to .env.local and adjust.

# Secret used to sign session JWTs. REQUIRED in production (any long random string).
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# WebAuthn relying-party settings. When unset, they are derived from the incoming
# request (hostname / origin), which works for localhost and most single-domain deploys.
# Set them explicitly in production behind a proxy.
# RP_ID=localhost
# RP_ORIGIN=http://localhost:3000
RP_NAME=Todo App

# Optional: path to the SQLite file (defaults to ./todos.db)
# DATABASE_PATH=./todos.db
